# Passphrase used to unlock /inbox (only you should know this)
ADMIN_PASSCODE=change-me-before-sharing

# InsForge (private notes storage)
INSFORGE_URL=https://your-app.us-east.insforge.app
INSFORGE_API_KEY=ik_xxx

# PostHog (public project token — safe in the browser)
# Get it from: https://app.posthog.com/settings/project#variables
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
